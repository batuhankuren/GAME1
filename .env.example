# Numara Hapishanesi - Environment Variables
# Production backend için gerekli değişkenler

# Database
DATABASE_URL="file:./dev.db"

# Server
PORT=3001
NODE_ENV=development

# JWT Secret (Production'da güçlü bir secret kullanın)
JWT_SECRET="change-this-in-production-use-a-long-random-string"

# Session
SESSION_SECRET="change-this-session-secret"
SESSION_MAX_AGE=86400000

# Game Config
DEFAULT_ROUND_DURATION=120
DEFAULT_MAX_MESSAGES=3
MIN_PLAYERS=2
MAX_PLAYERS=6

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# CORS (Production'da spesifik domain girin)
CORS_ORIGIN="*"

# Debug
ENABLE_DEBUG=false
